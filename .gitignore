# Raw data — never commit
*.pkl
*.pickle
READY_DATA/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Microsoft Office lock files (e.g. ~$slides.pptx while file is open)
~$*

# Build artifacts
*.log
.pytest_cache/

# Local-only secrets
.env
.env.local

# Large output files (anything >5MB should be ignored)
*.parquet

# Scratch verification screenshots (local-only diagnostics)
_verify_*.png
_diag*

# X drafts stay private (the _template/social/ skeleton is tracked)
projects/*/social/

# Transient print file written by renball_pdf --theme dark
_methodology_print.html

# Internal audits (findings on live projects stay private)
_audit/

# Local review pack for CK (hub, X review, calendar, decisions, feedback)
review/

# Local extraction caches (project builds)
**/data/.cache/
